# Cloudflare Pages redirects — clean URL langsung ke file asli
# GitHub Pages mengabaikan file ini (navigasi app pakai path file langsung).
# 301 dipakai agar path relatif aset (../js, ../akun, ../proyek) tetap benar.

# Home
/    /index.html    200

# Profil (akun)
/profil    /akun/Profile.html    301
/profil/    /akun/Profile.html    301
/profil/aktivitas    /akun/aktivitas.html    301
/profil/personal    /akun/profile/personal/    301
/profil/dompet    /akun/profile/dompet/    301
/profil/upgrade    /akun/langganan/upgrade/    301
/profil/langganan    /akun/langganan.html    301
/profil/konfirmasi-langganan    /akun/langganan/upgrade/konfirmasi/    301
/profil/kolaborasi    /akun/kolaborasi.html    301
/profil/kontrol-data    /akun/profile/kontrol-data/    301
/profil/laporkan-bug    /akun/laporkan-bug.html    301
/profil/tentang    /akun/tentang.html    301
/notifikasi    /akun/notifikasi.html    301

# Editor — sidebar link /editor/ langsung ke halaman editor asli (query ?pid= otomatis terjaga)
/editor    /proyek/workspace/editor/    301
/editor/   /proyek/workspace/editor/    301

# Halaman proyek — id proyek dipertahankan lewat ?id= (rute spesifik dulu, catch-all terakhir)
/workspace/*/pengaturan/umum    /proyek/pengaturan/umum/?id=:splat    301
/workspace/*/pengaturan/build-deployment    /proyek/build-deployment.html?id=:splat    301
/workspace/*/pengaturan/domain-kustom    /proyek/build-deployment/domain-kustom/?id=:splat    301
/workspace/*/pengaturan/keamanan-https    /proyek/pengaturan/keamanan-https/?id=:splat    301
/workspace/*/pengaturan/visibilitas-akses    /proyek/pengaturan/visibilitas-akses/?id=:splat    301
/workspace/*/pengaturan/integrasi-webhook    /proyek/pengaturan/integrasi-webhook/?id=:splat    301
/workspace/*/pengaturan/zona-bahaya    /proyek/pengaturan/zona-bahaya/?id=:splat    301
/workspace/*/pengaturan    /proyek/pengaturan.html?id=:splat    301
/workspace/*/chat    /proyek/chat.html?id=:splat    301
/workspace/*/environment    /proyek/pengaturan/environment/?id=:splat    301
/workspace/*/keamanan    /proyek/pengaturan/keamanan/?id=:splat    301
/workspace/*    /proyek/workspace.html?id=:splat    301

